---
// Tabbed section beneath the music card.
// Five tabs, each with its own layout ("kind"):
//   cards     — Projects, Explorations: thumbnail left, copy right
//   rows      — Webrings: compact link rows
//   guestbook — read-only list of entries (no write path yet)
//   shelf     — Bookshelf: cover grid
// Square corners throughout. Active tab is mirrored in the URL hash.

type CardItem = {
  title: string;
  blurb: string;
  category: string;
  /** Path under /public, e.g. "/assets/work/edh.png". Omit for the placeholder. */
  thumb?: string;
  /** Live site / repo. Renders the arrow icon beside the title. */
  live?: string;
  /** Case study or write-up. Renders the "More details" link. */
  details?: string;
};

type RingItem = {
  /** Used for the aria-labelledby link between the nav and its heading. */
  id: string;
  name: string;
  note: string;
  /** The ring's own homepage. */
  href: string;
  prev: string;
  next: string;
};
type GuestItem = {
  name: string;
  message: string;
  /** ISO date, e.g. "2026-07-22". */
  date: string;
  /** Shown under "Visit from" at the bottom of the stamp. */
  country: string;
  href?: string;
};
type BookItem = {
  title: string;
  author: string;
  /** Path under /public, e.g. "/assets/books/deep-work.jpg". 2:3 works best. */
  cover?: string;
  /** e.g. "Reading", "Finished", "Abandoned". Optional. */
  status?: string;
  href?: string;
};

/** Optional line above a panel's content. */
type Intro = { text: string; cta?: { label: string; href: string } };

/** Optional titled block below a panel's content, pointing somewhere else. */
type Outro = { title: string; text: string; cta: { label: string; href: string } };

type Tab =
  | { id: string; label: string; kind: 'cards'; intro?: Intro; outro?: Outro; items: CardItem[] }
  | { id: string; label: string; kind: 'rings'; intro?: Intro; outro?: Outro; items: RingItem[] }
  | { id: string; label: string; kind: 'guestbook'; intro?: Intro; outro?: Outro; items: GuestItem[] }
  | { id: string; label: string; kind: 'shelf'; intro?: Intro; outro?: Outro; items: BookItem[] };

const THUMB = '/assets/thumb-placeholder.svg';
const COVER = '/assets/cover-placeholder.svg';

// Lives in public/, so the path is served as-is. Swap the file to update the
// resume — no code change needed.
const RESUME_URL = '/Jeremiah-Alalade-Resume.pdf';

// The name registered with each webring. Typed once: Bucket's docs note that a
// mismatched name silently routes you to the wrong neighbours rather than
// erroring, so this is a bad thing to duplicate.
const RING_SLUG = 'jeremiah';

// ---- Edit me: this is the only part you need to touch ----
const tabs: Tab[] = [
  {
    id: 'projects',
    label: 'Projects',
    kind: 'cards',
    // The href is a tab id, not a page — the hash switches tabs in place.
    outro: {
      title: 'Guestbook',
      text: 'Leave your mark. A space for visitors to say hello, where everyone gets their own unique, custom-generated stamp :)',
      cta: { label: 'Sign the guestbook', href: '#guestbook' },
    },
    items: [
      {
        title: 'DocuCheck Africa',
        blurb:
          "One expired permit can shut down an entire construction site. Not because anyone was careless, but because compliance still lives on spreadsheets, and a certificate that lapsed in March doesn't announce itself until an inspector turns up in June. DocuCheck reads the document instead. Upload a permit, a scan, or a photo taken in bad light on site, and it comes back with pass, warning or fail in plain English, in under thirty seconds. The hard part was never the AI. It was the rulebooks. COREN and NESREA in Nigeria, EPA and LUSPA in Ghana, NHBRC and SANS 10400 in South Africa. No existing tool encodes any of that, which is exactly why those documents still get checked by hand, or not at all.",
        category: 'Product design / AI',
        thumb: '/assets/work/docucheck.jpg',
        live: 'https://docucheckafrica.jeremiahalalade.me/',
      },
      {
        title: 'Pixels',
        blurb:
          "I wanted to dither an image and every tool I found wanted me to upload it somewhere first. For a photo I had not published yet, that felt like the wrong trade. So Pixels does all of it in the browser. Nothing leaves your machine. Six algorithms: Floyd-Steinberg, Atkinson, Bayer, Stucki, Burkes, Sierra. Threshold, strength and dot size to push around, a two colour palette you set yourself, then noise, vignette, glitch and chromatic aberration on top if you want to ruin it properly. Drop, paste or browse an image in. Export at up to 4x. No account, no upload, no waiting.",
        category: 'Browser tool / Creative coding',
        thumb: '/assets/work/pixels.jpg',
        live: 'https://pixels.jeremiahalalade.me/',
      },
      {
        title: 'Spring Citadel International School',
        blurb:
          "A school running since 2008 with nothing online a parent could judge it by. A Facebook page and word of mouth in Minna, and that was it. Parents ask the same three things before they enrol: what does this place actually stand for, how do the students do, and how do I start. So the site answers those in that order and then gets out of the way. It also has to load on a bad connection, on a phone, on the first try. That shaped more decisions than anything aesthetic did.",
        category: 'Web design / Development',
        thumb: '/assets/work/spring-citadel.jpg',
        live: 'https://www.springcitadelschool.com/',
      },
    ],
  },
  {
    id: 'explorations',
    label: 'Explorations',
    kind: 'cards',
    items: [
      {
        title: 'Koffi',
        blurb:
          "Love for Koffi, fear of small places. That line came first and the whole page exists to earn it. Coffee brands crowd the frame with beans and steam and hands wrapped around mugs. This one leaves space instead, because room to breathe is the actual promise, and a layout can make that argument better than another sentence of copy can.",
        category: 'Brand / Landing page',
        thumb: '/assets/work/koffi.jpg',
        live: 'https://koffi.jeremiahalalade.me/',
      },
      {
        title: 'Picshare',
        blurb:
          "I miss the version of the internet where things felt like objects you could pick up. So this is a cork board. Pin photos to it, drag them around, leave them crooked. Nothing to sign up for, nothing to optimise, no feed. Just a board that behaves the way a board should when you push a photo across it.",
        category: 'Interaction / Drag and drop',
        thumb: '/assets/work/picshare.jpg',
        live: 'https://picshare.jeremiahalalade.me/',
      },
      {
        title: 'Weme',
        blurb:
          "Selling something abstract is where landing pages give up and reach for a photo of someone smiling at a laptop. Weme captures and organises ideas across work, life and everything in between, which means there is no product shot to lean on. So the page had to make an invisible thing feel like something you could hold, without overpromising what it does.",
        category: 'Product / Landing page',
        thumb: '/assets/work/weme.jpg',
        live: 'https://weme.jeremiahalalade.me/',
      },
      {
        title: 'Pricing',
        blurb:
          "Pricing pages are where clarity matters most and gets designed least. Three tiers for a payments product, a monthly and yearly toggle, and a FAQ underneath answering the things people actually email support about. The only test that counts is whether you can compare the plans without reading anything twice.",
        category: 'UI / Pricing page',
        thumb: '/assets/work/pricing.jpg',
        live: 'https://pricing.jeremiahalalade.me/',
      },
      {
        title: 'Hero',
        blurb:
          "One hero section on its own, with nowhere to hide. One headline, one supporting line, one action. When there is no second section to carry the weight, you find out very quickly whether the message is any good or whether you were relying on scroll to save it.",
        category: 'UI / Hero section',
        thumb: '/assets/work/hero.jpg',
        live: 'https://hero.jeremiahalalade.me/',
      },
      {
        title: 'Apex',
        blurb:
          "The footer is the part of the page everyone leaves until last, so I started there on purpose. Oversized type carries the sign off, thank you for your curiosity, let's build something cool, and the link columns sit underneath without competing with it. Most footers are a dumping ground. This one had to feel like an ending.",
        category: 'UI / Footer section',
        thumb: '/assets/work/apex.jpg',
        live: 'https://apex.jeremiahalalade.me/',
      },
    ],
  },
  {
    id: 'webrings',
    label: 'Webrings',
    kind: 'rings',
    items: [
      {
        // No slug in these URLs by design: this ring resolves your position
        // from the referrer header, which is why referrerpolicy matters below.
        id: 'design-systems',
        name: 'Design Systems Webring',
        note: 'For design system practitioners',
        href: 'https://design-system.club/',
        prev: 'https://design-system.club/prev',
        next: 'https://design-system.club/next',
      },
      {
        id: 'bucket',
        name: 'Bucket Webring',
        note: 'For people who like making things',
        href: 'https://webring.bucketfish.me/',
        prev: `https://webring.bucketfish.me/redirect.html?to=prev&name=${RING_SLUG}`,
        next: `https://webring.bucketfish.me/redirect.html?to=next&name=${RING_SLUG}`,
      },
      {
        id: 'hotline',
        name: 'Hotline Webring',
        note: 'For personal and creative sites',
        href: 'https://hotlinewebring.club/',
        prev: `https://hotlinewebring.club/${RING_SLUG}/previous`,
        next: `https://hotlinewebring.club/${RING_SLUG}/next`,
      },
    ],
  },
  {
    id: 'guestbook',
    label: 'Guestbook',
    kind: 'guestbook',
    items: [
      {
        name: 'Fabio',
        message: 'Super neat guestbook. Very nostalgic too. Put a smile on my face.',
        date: '2026-07-22',
        country: 'Brazil',
        href: '#',
      },
      {
        name: 'Likando',
        message: 'Your work inspires me. Read a few of the writeups and the detail is unreal.',
        date: '2026-07-01',
        country: 'Zambia',
      },
      {
        name: 'Leon',
        message: 'Thank you for visiting my site. You have a cool website and the guestbook is even better.',
        date: '2026-06-27',
        country: 'Iceland',
      },
    ],
  },
  {
    id: 'bookshelf',
    label: 'Bookshelf',
    kind: 'shelf',
    items: [
      {
        title: 'The Design of Everyday Things',
        author: 'Don Norman',
        cover: '/assets/books/design-of-everyday-things.jpg',
      },
      {
        title: 'Atomic Habits',
        author: 'James Clear',
        cover: '/assets/books/atomic-habits.jpg',
      },
      {
        title: 'The Steal Like an Artist Journal',
        author: 'Austin Kleon',
        cover: '/assets/books/steal-like-an-artist-journal.jpg',
      },
      {
        title: 'Eat That Frog!',
        author: 'Brian Tracy',
        cover: '/assets/books/eat-that-frog.jpg',
      },
      {
        title: 'Just Shut Up and Do It!',
        author: 'Brian Tracy',
        cover: '/assets/books/just-shut-up-and-do-it.jpg',
      },
      {
        title: 'The Richest Man in Babylon',
        author: 'George S. Clason',
        cover: '/assets/books/richest-man-in-babylon.jpg',
      },
      {
        title: 'Deep Work',
        author: 'Cal Newport',
        cover: '/assets/books/deep-work.jpg',
      },
      {
        title: 'Ideas Rule The World',
        author: 'Sam Adeyemi',
        cover: '/assets/books/ideas-rule-the-world.jpg',
      },
      {
        title: 'Sell Like Crazy',
        author: 'Sabri Suby',
        cover: '/assets/books/sell-like-crazy.jpg',
      },
      {
        title: '$100M Offers',
        author: 'Alex Hormozi',
        cover: '/assets/books/100m-offers.jpg',
      },
      {
        title: 'The 48 Laws of Power',
        author: 'Robert Greene',
        cover: '/assets/books/48-laws-of-power.jpg',
      },
      {
        title: 'Making It Big',
        author: 'Femi Otedola',
        cover: '/assets/books/making-it-big.jpg',
      },
      {
        title: 'Ikigai',
        author: 'García and Miralles',
        cover: '/assets/books/ikigai.jpg',
      },
      {
        title: 'The Subtle Art of Not Giving a F*ck',
        author: 'Mark Manson',
        cover: '/assets/books/subtle-art.jpg',
      },
      {
        title: "So Good They Can't Ignore You",
        author: 'Cal Newport',
        cover: '/assets/books/so-good-they-cant-ignore-you.jpg',
      },
      {
        title: 'The Jewish Phenomenon',
        author: 'Steven Silbiger',
        cover: '/assets/books/the-jewish-phenomenon.jpg',
      },
    ],
