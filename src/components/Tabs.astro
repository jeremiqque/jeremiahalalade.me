---
import Support from './Support.astro';
// Tabbed section beneath the music card.
// Five tabs, each with its own layout ("kind"):
//   cards     — Projects, Lab: thumbnail left, copy right
//   rows      — Webrings: compact link rows
//   guestbook — read-only list of entries (no write path yet)
//   shelf     — Bookshelf: cover grid
// Square corners throughout. Active tab is mirrored in the URL hash.

type CardItem = {
  title: string;
  blurb: string;
  category: string;
  /** Path under /public, e.g. "/assets/work/edh.png". Omit for the placeholder. */
  thumb?: string;
  /** Live site / repo. Renders the arrow icon beside the title. */
  live?: string;
  /** Case study page the card title links to. */
  details?: string;
};

type RingItem = {
  /** Used for the aria-labelledby link between the nav and its heading. */
  id: string;
  name: string;
  note: string;
  /** The ring's own homepage. */
  href: string;
  prev: string;
  next: string;
};
type GuestItem = {
  name: string;
  message: string;
  /** ISO date, e.g. "2026-07-22". */
  date: string;
  /** Shown under "Visit from" at the bottom of the stamp. */
  country: string;
  href?: string;
};
type BookItem = {
  title: string;
  author: string;
  /** Path under /public, e.g. "/assets/books/deep-work.jpg". 2:3 works best. */
  cover?: string;
  /** e.g. "Reading", "Finished", "Abandoned". Optional. */
  status?: string;
  href?: string;
};

type PostItem = {
  title: string;
  description: string;
  /** ISO date, e.g. "2026-11-09". */
  date: string;
  href: string;
};

type Tab =
  | { id: string; label: string; kind: 'list'; items: { title: string; description: string; href: string }[] }
  | { id: string; label: string; kind: 'writing'; items: PostItem[] }
  | { id: string; label: string; kind: 'cards'; inProgress?: boolean; items: CardItem[] }
  | { id: string; label: string; kind: 'rings'; items: RingItem[] }
  | { id: string; label: string; kind: 'guestbook'; items: GuestItem[] }
  | { id: string; label: string; kind: 'shelf'; items: BookItem[] };

const THUMB = '/assets/thumb-placeholder.svg';
const COVER = '/assets/cover-placeholder.svg';

// Lives in public/, so the path is served as-is. Swap the file to update the
// resume — no code change needed.
const RESUME_URL = '/Jeremiah-Alalade-Resume.pdf';

// The name registered with each webring. Typed once: Bucket's docs note that a
// mismatched name silently routes you to the wrong neighbours rather than
// erroring, so this is a bad thing to duplicate.
const RING_SLUG = 'jeremiah';

// ---- Writing: every Markdown file in src/content/writing becomes a post ----
// Add a file, redeploy, and it shows up here (newest first). Files whose name
// starts with "_" and posts with `draft: true` are skipped.
const postModules = import.meta.glob('../content/writing/*.md', { eager: true }) as Record<
  string,
  { frontmatter: { title: string; description?: string; date: string; draft?: boolean } }
>;
const posts: PostItem[] = Object.entries(postModules)
  .map(([path, mod]) => ({
    slug: path.split('/').pop()!.replace(/\.md$/, ''),
    ...mod.frontmatter,
  }))
  .filter((p) => !p.slug.startsWith('_') && !p.draft)
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .map((p) => ({
    title: p.title,
    description: p.description ?? '',
    date: String(p.date),
    href: `/writing/${p.slug}`,
  }));

// ---- Edit me: this is the only part you need to touch ----
const tabs: Tab[] = [
  {
    id: 'projects',
    label: 'Projects',
    kind: 'cards',
    inProgress: true,
    items: [
      {
        title: 'DocuCheck Africa',
        blurb: 'Checks construction permits against local rules and gives a pass, warning or fail.',
        details: '/work/docucheck-africa',
        category: 'Product design / AI',
        thumb: '/assets/work/docucheck.jpg',
        live: 'https://docucheckafrica.jeremiahalalade.me/',
      },
      {
        title: 'Pixels',
        blurb: 'Dither any image in your browser. Nothing is uploaded.',
        details: '/work/pixels',
        category: 'Browser tool / Creative coding',
        thumb: '/assets/work/pixels.jpg',
        live: 'https://pixels.jeremiahalalade.me/',
      },
      {
        title: 'Spring Citadel International School',
        blurb: 'A fast, clear website for a Minna school with no online presence.',
        details: '/work/spring-citadel-international-school',
        category: 'Web design / Development',
        thumb: '/assets/work/spring-citadel.jpg',
        live: 'https://www.springcitadelschool.com/',
      },
    ],
  },
  {
    id: 'lab',
    label: 'Lab',
    kind: 'list',
    items: [
      { title: 'Koffi', description: 'Coffee brand landing page built around space, not beans.', href: '/work/koffi' },
      { title: 'Picshare', description: 'A cork board for photos you can drag and pin.', href: '/work/picshare' },
      { title: 'Weme', description: 'Landing page for an idea-capture app.', href: '/work/weme' },
      { title: 'Pricing', description: 'A three-tier pricing page you can read once.', href: '/work/pricing' },
      { title: 'Hero', description: 'One hero section with nowhere to hide.', href: '/work/hero' },
      { title: 'Apex', description: 'A footer built to feel like an ending.', href: '/work/apex' },
      { title: 'Navara Energy Services', description: 'Homepage for an energy and marine company.', href: '/work/navara-energy-services' },
      { title: 'DocuCheck Africa — Sign in', description: 'Login screen on a construction-site backdrop.', href: '/work/docucheck-africa-sign-in' },
      { title: 'Spring Citadel — 404 page', description: 'A not-found page with a clear way home.', href: '/work/spring-citadel-404-page' },
    ],
  },
  {
    id: 'writing',
    label: 'Writing',
    kind: 'writing',
    items: posts,
  },
  {
    id: 'bookshelf',
    label: 'Bookshelf',
    kind: 'shelf',
    items: [
      {
        title: 'The Design of Everyday Things',
        author: 'Don Norman',
        cover: '/assets/books/design-of-everyday-things.jpg',
      },
      {
        title: 'Atomic Habits',
        author: 'James Clear',
        cover: '/assets/books/atomic-habits.jpg',
      },
      {
        title: 'The Steal Like an Artist Journal',
        author: 'Austin Kleon',
        cover: '/assets/books/steal-like-an-artist-journal.jpg',
      },
      {
        title: 'Eat That Frog!',
        author: 'Brian Tracy',
        cover: '/assets/books/eat-that-frog.jpg',
      },
      {
        title: 'Just Shut Up and Do It!',
        author: 'Brian Tracy',
        cover: '/assets/books/just-shut-up-and-do-it.jpg',
      },
      {
        title: 'The Richest Man in Babylon',
        author: 'George S. Clason',
        cover: '/assets/books/richest-man-in-babylon.jpg',
      },
      {
        title: 'Deep Work',
        author: 'Cal Newport',
        cover: '/assets/books/deep-work.jpg',
      },
      {
        title: 'Ideas Rule The World',
        author: 'Sam Adeyemi',
        cover: '/assets/books/ideas-rule-the-world.jpg',
      },
      {
        title: 'Sell Like Crazy',
        author: 'Sabri Suby',
        cover: '/assets/books/sell-like-crazy.jpg',
      },
      {
        title: '$100M Offers',
        author: 'Alex Hormozi',
        cover: '/assets/books/100m-offers.jpg',
      },
      {
        title: 'The 48 Laws of Power',
        author: 'Robert Greene',
        cover: '/assets/books/48-laws-of-power.jpg',
      },
      {
        title: 'Making It Big',
        author: 'Femi Otedola',
        cover: '/assets/books/making-it-big.jpg',
      },
      {
        title: 'Ikigai',
        author: 'García and Miralles',
        cover: '/assets/books/ikigai.jpg',
      },
      {
        title: 'The Subtle Art of Not Giving a F*ck',
        author: 'Mark Manson',
        cover: '/assets/books/subtle-art.jpg',
      },
      {
        title: "So Good They Can't Ignore You",
        author: 'Cal Newport',
        cover: '/assets/books/so-good-they-cant-ignore-you.jpg',
      },
      {
        title: 'The Jewish Phenomenon',
        author: 'Steven Silbiger',
        cover: '/assets/books/the-jewish-phenomenon.jpg',
      },
    ],
  },
  {
    id: 'guestbook',
    label: 'Guestbook',
    kind: 'guestbook',
    items: [
      {
        name: 'Fabio',
        message: 'Super neat guestbook. Very nostalgic too. Put a smile on my face.',
        date: '2026-07-22',
        country: 'Brazil',
        href: '#',
      },
      {
        name: 'Likando',
        message: 'Your work inspires me. Read a few of the writeups and the detail is unreal.',
        date: '2026-07-01',
        country: 'Zambia',
      },
      {
        name: 'Leon',
        message: 'Thank you for visiting my site. You have a cool website and the guestbook is even better.',
        date: '2026-06-27',
        country: 'Iceland',
      },
    ],
  },
  {
    id: 'webrings',
    label: 'Webrings',
    kind: 'rings',
    items: [
      {
        // No slug in these URLs by design: this ring resolves your position
        // from the referrer header, which is why referrerpolicy matters below.
        id: 'design-systems',
        name: 'Design Systems Webring',
        note: 'For design system practitioners',
        href: 'https://design-system.club/',
        prev: 'https://design-system.club/prev',
        next: 'https://design-system.club/next',
      },
      {
        id: 'bucket',
        name: 'Bucket Webring',
        note: 'For people who like making things',
        href: 'https://webring.bucketfish.me/',
        prev: `https://webring.bucketfish.me/redirect.html?to=prev&name=${RING_SLUG}`,
        next: `https://webring.bucketfish.me/redirect.html?to=next&name=${RING_SLUG}`,
      },
      {
        id: 'hotline',
        name: 'Hotline Webring',
        note: 'For personal and creative sites',
        href: 'https://hotlinewebring.club/',
        prev: `https://hotlinewebring.club/${RING_SLUG}/previous`,
        next: `https://hotlinewebring.club/${RING_SLUG}/next`,
      },
    ],
  },
];

const fmtDate = (iso: string) => {
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? iso
    : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};
---

<section class="tabs" data-tabs aria-label="More about me">
  <div class="tab-row">
    <div class="tablist" role="tablist" aria-label="Sections">
      {
        tabs.map((tab, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            data-tab={tab.id}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    {/* Not a tab: it opens the PDF instead of revealing a panel, so it sits
        outside the tablist (a plain link inside role="tablist" is invalid ARIA)
        but reuses .tab so the row still reads as one set. */}
    <a
      class="tab resume"
      href={RESUME_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Resume (PDF, opens in a new tab)"
    >
      <span>Resume</span>
      <svg class="resume-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3.75v10.5" />
        <path d="m7.75 10.5 4.25 4.25 4.25-4.25" />
        <path d="M4.75 19.5h14.5" />
      </svg>
    </a>
  </div>

  {
    tabs.map((tab, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`panel-${tab.id}`}
        data-panel={tab.id}
        aria-labelledby={`tab-${tab.id}`}
        tabindex="0"
        hidden={i !== 0}
      >
        {tab.items.length === 0 && (
          <p class="empty">
            {tab.kind === 'writing' ? 'Nothing published yet. The first post is on its way.' : 'Building something for this one.'}
          </p>
        )}

        {tab.kind === 'list' && (
          <ul class="posts">
            {tab.items.map((item) => (
              <li>
                <a class="post" href={item.href}>
                  <span class="post-title">{item.title}</span>
                  <span class="post-desc">{item.description}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {tab.kind === 'writing' && tab.items.length > 0 && (
          <ul class="posts">
            {tab.items.map((item) => (
              <li>
                <a class="post" href={item.href}>
                  <span class="post-title">{item.title}</span>
                  {item.description && <span class="post-desc">{item.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}

        {tab.kind === 'cards' && tab.items.length > 0 && (
          <div class="cards-wrap" data-wip={tab.inProgress ? '' : undefined}>
            {tab.inProgress && (
              <aside class="wip-note" aria-label="Work in progress">
                <p class="wip-label">Work in progress</p>
                <p class="wip-text">
                  I'm rebuilding this section to better show what I do now. While it's in progress, you can look through my <a href="#lab">Lab</a>, read my <a href="#writing">Writing</a>, or find me on <a href="https://github.com/jeremiqque" target="_blank" rel="noopener noreferrer">GitHub</a> for live work.
                </p>
              </aside>
            )}
          <ul class="cards" inert={tab.inProgress ? true : undefined}>
            {tab.items.map((item) => (
              <li class="card">
                <div class="card-media">
                  <img
                    src={item.thumb || THUMB}
                    alt={item.thumb ? `${item.title} preview` : ''}
                    loading="lazy"
                    decoding="async"
                    width="320"
                    height="200"
                    draggable="false"
                  />
                </div>

                <div class="card-body">
                  <div class="card-head">
                    <h2 class="card-title">{item.details ? <a class="card-title-link" href={item.details}>{item.title}</a> : item.title}</h2>
                    {item.live && (
                      <a
                        class="card-out"
                        href={item.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open ${item.title} in a new tab`}
                      >
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                          <path d="M14 4h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          <path d="M20 4 11 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                          <path d="M17 15v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    )}
                  </div>

                  <p class="card-blurb" data-blurb id={`blurb-${tab.id}-${item.title.replace(/\W+/g, '-').toLowerCase()}`}>
                    {item.blurb}
                  </p>

                  <div class="card-foot">
                    <span class="card-cat">{item.category}</span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
          </div>
        )}

        {tab.kind === 'rings' && tab.items.length > 0 && (
          <ul class="rings">
            {tab.items.map((item) => (
              <li class="ring">
                {/* nav + heading, because Design Systems Webring allows any
                    styling "as long as it's done in an accessible way", and
                    their own snippet is a labelled landmark. */}
                <nav class="ring-nav" aria-labelledby={`ring-${item.id}`}>
                  <a
                    class="ring-arrow"
                    href={item.prev}
                    rel="external"
                    referrerpolicy="strict-origin"
                    aria-label={`Previous site in ${item.name}`}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                      <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>

                  <div class="ring-body">
                    <h2 class="ring-name" id={`ring-${item.id}`}>
                      <a href={item.href} target="_blank" rel="noopener noreferrer">{item.name}</a>
                    </h2>
                    <p class="ring-note">{item.note}</p>
                  </div>

                  <a
                    class="ring-arrow"
                    href={item.next}
                    rel="external"
                    referrerpolicy="strict-origin"
                    aria-label={`Next site in ${item.name}`}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </nav>
              </li>
            ))}
          </ul>
        )}

        {tab.kind === 'guestbook' && (
          <ul class="guests" data-guests>
            {/* Add tile: sits in the first cell and swaps to the form on click. */}
            <li class="guest guest-add" data-add>
              <button class="add-plus" type="button" data-add-open>
                <span class="add-icon" aria-hidden="true">+</span>
                <span class="add-label">Sign the guestbook</span>
              </button>

              <form class="sign" data-sign>
                <input
                  class="sign-input"
                  type="text"
                  name="name"
                  maxlength="32"
                  required
                  placeholder="Your name"
                  aria-label="Your name"
                  autocomplete="nickname"
                />
                <textarea
                  class="sign-input sign-msg"
                  name="message"
                  maxlength="280"
                  rows="3"
                  required
                  placeholder="Say something"
                  aria-label="Your message"
                />
                {/* type is text, not url, on purpose: type="url" rejects a bare
                    domain, which the server accepts and normalises to https. */}
                <input
                  class="sign-input"
                  type="text"
                  name="link"
                  maxlength="200"
                  placeholder="Link (optional)"
                  aria-label="Your link, optional"
                  autocomplete="url"
                  inputmode="url"
                />

                {/* Honeypot. Hidden from people, catnip for bots. */}
                <input class="sign-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

                <div class="sign-actions">
                  <button class="sign-btn" type="submit">Sign</button>
                  <button class="sign-cancel" type="button" data-add-close>Cancel</button>
                </div>

                <p class="sign-note" data-sign-note role="status">
                  Your country is stamped on automatically.
                </p>
              </form>
            </li>

            {tab.items.map((item) => (
              <li class="guest" data-placeholder>
                <span class="corner tl" aria-hidden="true" />
                <span class="corner tr" aria-hidden="true" />
                <span class="corner bl" aria-hidden="true" />
                <span class="corner br" aria-hidden="true" />

                <span class="postmark" aria-hidden="true">
                  <span>Visited</span>
                  <span>{item.date.slice(0, 4)}</span>
                </span>

                <time class="guest-date" datetime={item.date}>{fmtDate(item.date)}</time>

                <p class="guest-msg">{item.message}</p>

                <div class="guest-foot">
                  {item.href ? (
                    <a class="guest-name" href={item.href} target="_blank" rel="noopener noreferrer">
                      {item.name}
                    </a>
                  ) : (
                    <span class="guest-name">{item.name}</span>
                  )}
                  <span class="guest-from">Visit from</span>
                  <span class="guest-country">{item.country}</span>
                </div>
              </li>
            ))}
          </ul>
        )}

        {/* Cloned for live entries. Rendered by Astro so the clones inherit the
            scoped-style attribute that hand-built DOM nodes would not get. */}
        {tab.kind === 'guestbook' && (
          <template data-stamp>
            <li class="guest">
              <span class="corner tl" aria-hidden="true" />
              <span class="corner tr" aria-hidden="true" />
              <span class="corner bl" aria-hidden="true" />
              <span class="corner br" aria-hidden="true" />

              <span class="postmark" aria-hidden="true">
                <span>Visited</span>
                <span data-year />
              </span>

              <time class="guest-date" data-date />

              <p class="guest-msg" data-message />

              {/* Both name variants ship in the template and JS deletes the
                  unused one. Creating an <a> on the fly would lose Astro's
                  scoped-style attribute and render unstyled. */}
              <div class="guest-foot">
                <a class="guest-name" data-name-link target="_blank" rel="noopener noreferrer nofollow" />
                <span class="guest-name" data-name />
                <span class="guest-from">Visit from</span>
                <span class="guest-country" data-country />
              </div>
            </li>
          </template>
        )}

        {tab.kind === 'shelf' && tab.items.length > 0 && (
          <ul class="shelf">
            {tab.items.map((item) => (
              <li class="book">
                {/* Mat frame around the cover, the way a print sits in a mount. */}
                <div class="book-frame">
                  <div class="book-cover">
                    <img
                      src={item.cover || COVER}
                      alt={item.cover ? `${item.title} cover` : ''}
                      loading="lazy"
                      decoding="async"
                      width="200"
                      height="300"
                      draggable="false"
                    />
                  </div>
                </div>

                {/* Hidden until hover or keyboard focus. */}
                <div class="book-meta">
                  <p class="book-title">
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}</a>
                    ) : (
                      item.title
                    )}
                  </p>
                  <p class="book-author">{item.author}</p>
                  {item.status && <p class="book-status">{item.status}</p>}
                </div>
              </li>
            ))}
          </ul>
        )}

        {tab.id === 'projects' && <Support />}
      </div>
    ))
  }
</section>

<script is:inline>
  // List rows share one highlight that glides from row to row and leans toward
  // the pointer; the tab bar fades at whichever edge has more to scroll to.
  // (Behaviour studied on raphaelsalaja.com; own code.)
  (function () {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ----- Tab bar: soft edge fades while it can still scroll -----
    var row = document.querySelector('.tab-row');
    if (row) {
      var fade = function () {
        var max = row.scrollWidth - row.clientWidth;
        row.style.setProperty('--fs', row.scrollLeft > 2 ? '28px' : '0px');
        row.style.setProperty('--fe', max - row.scrollLeft > 2 ? '28px' : '0px');
      };
      row.addEventListener('scroll', fade, { passive: true });
      window.addEventListener('resize', fade);
      fade();
      // Keep the chosen tab in view when it sits partly off-screen.
      row.addEventListener('click', function (e) {
        var t = e.target.closest && e.target.closest('[role=tab]');
        if (t) t.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: reduced ? 'auto' : 'smooth' });
      });
    }

    if (reduced) return;
    var curve = function (v) { v = Math.max(-1, Math.min(1, v)); return Math.sign(v) * (1 - Math.sqrt(1 - Math.abs(v))); };

    Array.prototype.forEach.call(document.querySelectorAll('ul.posts'), function (ul) {
      var pill = document.createElement('li');
      pill.className = 'posts-pill snap';
      pill.setAttribute('aria-hidden', 'true');
      pill.setAttribute('role', 'presentation');
      ul.appendChild(pill);
      ul.classList.add('has-pill');

      var active = null, hideTimer = 0, visible = false;

      function place(li) {
        var a = li.firstElementChild;
        if (!a) return;
        var u = ul.getBoundingClientRect(), r = a.getBoundingClientRect();
        pill.style.top = (r.top - u.top) + 'px';
        pill.style.left = (r.left - u.left) + 'px';
        pill.style.width = r.width + 'px';
        pill.style.height = r.height + 'px';
      }
      function shift(a, x, y) {
        a.style.setProperty('--dx', x.toFixed(2) + 'px');
        a.style.setProperty('--dy', y.toFixed(2) + 'px');
      }

      Array.prototype.forEach.call(ul.children, function (li) {
        if (li === pill) return;
        li.addEventListener('pointerenter', function (e) {
          if (e.pointerType === 'touch') return;
          clearTimeout(hideTimer);
          if (active && active !== li) shift(active.firstElementChild, 0, 0);
          // First entry appears in place; moving between rows glides.
          pill.classList.toggle('snap', !visible);
          active = li;
          place(li);
          visible = true;
          pill.style.opacity = '1';
        });
        li.addEventListener('pointerleave', function () {
          if (li.firstElementChild) shift(li.firstElementChild, 0, 0);
          hideTimer = setTimeout(function () {
            visible = false; active = null;
            pill.style.opacity = '0';
            pill.style.transform = '';
          }, 500);
        });
      });

      ul.addEventListener('pointermove', function (e) {
        if (e.pointerType === 'touch' || !active) return;
        var a = active.firstElementChild;
        if (!a) return;
        var r = a.getBoundingClientRect();
        var nx = (e.clientX - r.left) / r.width * 2 - 1;
        var ny = (e.clientY - r.top) / r.height * 2 - 1;
        var x = 10 * curve(nx), y = 6 * curve(ny);
        pill.style.transform =
          'translate(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px) rotateX(' + (-Math.max(-1, Math.min(1, ny)) * 1.2).toFixed(2) +
          'deg) rotateY(' + (Math.max(-1, Math.min(1, nx)) * 0.8).toFixed(2) + 'deg)';
        shift(a, x * 0.18, y * 0.18);
      });
      ul.addEventListener('pointerleave', function () { pill.style.transform = ''; });
    });
  })();
</script>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-tabs]');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-panel]'));
    if (!tabs.length) return;

    function select(id, opts) {
      var found = false;
      tabs.forEach(function (tab) {
        var on = tab.dataset.tab === id;
        if (on) found = true;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
      if (!found) return false;

      panels.forEach(function (panel) {
        panel.hidden = panel.dataset.panel !== id;
      });

      if (opts && opts.focus) {
        var active = root.querySelector('[data-tab="' + id + '"]');
        if (active) active.focus();
      }
      if (opts && opts.hash && history.replaceState) {
        history.replaceState(null, '', '#' + id);
      }
      return true;
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        select(tab.dataset.tab, { hash: true });
      });
    });

    // Left/Right/Home/End move between tabs, per the WAI-ARIA tabs pattern.
    root.querySelector('[role="tablist"]').addEventListener('keydown', function (e) {
      var i = tabs.indexOf(document.activeElement);
      if (i === -1) return;
      var next = null;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next === null) return;
      e.preventDefault();
      select(tabs[next].dataset.tab, { focus: true, hash: true });
    });

    // Restore from the hash on load, and follow back/forward.
    var fromHash = (location.hash || '').replace('#', '');
    if (fromHash) select(fromHash);
    window.addEventListener('hashchange', function () {
      select((location.hash || '').replace('#', ''));
    });

    // ----- Guestbook: live entries + signing -----
    var guests = root.querySelector('[data-guests]');
    var signForm = root.querySelector('[data-sign]');
    var signNote = root.querySelector('[data-sign-note]');
    var DEFAULT_NOTE = signNote ? signNote.textContent : '';

    function fmtDate(iso) {
      var d = new Date(iso);
      if (isNaN(d.getTime())) return iso;
      return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    // Clone Astro's rendered <template> rather than building nodes by hand.
    // Astro scopes this component's CSS with a generated data-astro-cid-*
    // attribute that it only adds to markup it compiled — nodes made with
    // createElement never get it, so they render completely unstyled.
    var stampTpl = root.querySelector('template[data-stamp]');

    function stamp(entry) {
      if (!stampTpl) return null;
      var li = stampTpl.content.firstElementChild.cloneNode(true);

      var set = function (sel, text) {
        var el = li.querySelector(sel);
        if (el) el.textContent = text;
        return el;
      };

      set('[data-year]', String(entry.date || '').slice(0, 4));
      var time = set('[data-date]', fmtDate(entry.date));
      if (time) time.setAttribute('datetime', entry.date || '');
      set('[data-message]', entry.message || '');
      set('[data-country]', entry.country || 'Somewhere');

      // Keep whichever name variant the entry calls for, drop the other.
      var link = li.querySelector('[data-name-link]');
      var plain = li.querySelector('[data-name]');
      if (entry.href) {
        if (link) {
          link.textContent = entry.name || '';
          link.setAttribute('href', entry.href);
        }
        if (plain) plain.remove();
      } else {
        if (plain) plain.textContent = entry.name || '';
        if (link) link.remove();
      }

      return li;
    }

    // Removes only the seeded placeholders, never the add tile.
    function clearPlaceholders() {
      Array.prototype.slice
        .call(guests.querySelectorAll('[data-placeholder]'))
        .forEach(function (el) { el.remove(); });
    }

    var loaded = false;
    function loadGuests() {
      if (loaded || !guests) return;
      loaded = true;
      fetch('/api/guestbook')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          var entries = (data && data.entries) || [];
          // Leave the placeholders alone until there's something real to show.
          if (!entries.length) return;
          clearPlaceholders();
          var addTile = guests.querySelector('[data-add]');
          entries.forEach(function (entry) {
            var li = stamp(entry);
            if (!li) return;
            li.setAttribute('data-live', '1');
            guests.appendChild(li);
          });
          // Keep the add tile first.
          if (addTile) guests.insertBefore(addTile, guests.firstChild);
        })
        .catch(function () {});
    }

    // ----- Add tile open / close -----
    var addTile = root.querySelector('[data-add]');
    var addOpen = root.querySelector('[data-add-open]');
    var addClose = root.querySelector('[data-add-close]');

    function openAdd() {
      if (!addTile) return;
      addTile.classList.add('is-signing');
      var first = addTile.querySelector('.sign-input');
      if (first) first.focus();
    }
    function closeAdd() {
      if (!addTile) return;
      addTile.classList.remove('is-signing');
      if (addOpen) addOpen.focus();
    }

    if (addOpen) addOpen.addEventListener('click', openAdd);
    if (addClose) addClose.addEventListener('click', closeAdd);
    if (addTile) {
      addTile.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && addTile.classList.contains('is-signing')) closeAdd();
      });
    }

    if (signForm) {
      signForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = signForm.querySelector('.sign-btn');
        var data = {
          name: signForm.elements.name.value,
          message: signForm.elements.message.value,
          link: signForm.elements.link.value,
          website: signForm.elements.website.value,
        };

        btn.disabled = true;
        if (signNote) signNote.textContent = 'Signing…';

        fetch('/api/guestbook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        })
          .then(function (r) {
            return r.json().then(function (body) { return { ok: r.ok, body: body }; });
          })
          .then(function (res) {
            if (!res.ok) {
              if (signNote) signNote.textContent = res.body.error || 'That did not go through.';
              return;
            }
            if (res.body.entry && guests) {
              // Drop the seeded placeholders the first time a real entry lands.
              if (!guests.querySelector('[data-live]')) clearPlaceholders();
              var li = stamp(res.body.entry);
              if (li) {
                li.setAttribute('data-live', '1');
                // After the add tile, so it stays in the first cell.
                guests.insertBefore(li, addTile ? addTile.nextSibling : guests.firstChild);
              }
            }
            signForm.reset();
            if (signNote) signNote.textContent = 'Signed. Thanks for stopping by.';
            setTimeout(closeAdd, 1200);
          })
          .catch(function () {
            if (signNote) signNote.textContent = 'Network trouble. Try again.';
          })
          .then(function () {
            btn.disabled = false;
            setTimeout(function () {
              if (signNote) signNote.textContent = DEFAULT_NOTE;
            }, 6000);
          });
      });
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        if (tab.dataset.tab === 'guestbook') loadGuests();
      });
    });
    // Deep link straight to #guestbook should fetch without a click.
    if (fromHash === 'guestbook') loadGuests();
  })();
</script>

<style>
  .tabs {
    width: 100%;
    margin-top: clamp(18px, 2.2vw, 28px);
    font-family: var(--font-body, sans-serif);
  }

  /* ----- Tab row ----- */
  /* Wrapper so the resume link can sit in the same visual row as the tabs
     without being a child of role="tablist". */

  /* display: contents so the five tabs become direct flex children of
     .tab-row. As its own flex item the tablist wrapped as one block, which
     pushed Resume onto a line of its own; this way all six items flow in a
     single wrapping row. The role="tablist" is preserved — modern engines keep
     the ARIA role under display: contents. */
  .tablist {
    display: contents;
  }

  .tab {
    appearance: none;
    cursor: pointer;
    padding: 9px 18px;
    border-radius: 0;
    border: 1px dashed var(--tab-border, rgba(255, 255, 255, 0.18));
    background: transparent;
    color: var(--tab-text, rgba(242, 242, 242, 0.6));
    font-family: inherit;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .tab:hover {
    color: var(--tab-text-hover, #f2f2f2);
    border-color: var(--tab-border-hover, rgba(255, 255, 255, 0.32));
  }

  .tab:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  /* Selected tab goes solid accent. Border matches the fill so the pill reads
     as one shape rather than a filled box inside an outline. */
  .tab[aria-selected='true'] {
    border-style: solid;
    border-color: var(--tab-on-bg, #cb4834);
    background: var(--tab-on-bg, #cb4834);
    color: var(--tab-on-text, #ffffff);
  }
  .tab[aria-selected='true']:hover {
    border-color: var(--tab-on-bg, #cb4834);
    color: var(--tab-on-text, #ffffff);
  }

  /* ----- Resume link (styled as a tab, behaves as a link) ----- */
  .resume {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    /* The tabs are buttons with line-height 1 and no descender box; the link
       needs the same optical height, so trim the vertical padding by the 1px
       the inline-flex box adds. */
    padding: 8px 16px 8px 18px;
  }
  .resume-icon {
    flex: none;
    transition: transform 0.2s ease;
  }
  .resume:hover .resume-icon { transform: translateY(2px); }

  @media (prefers-reduced-motion: reduce) {
    .resume:hover .resume-icon { transform: none; }
  }

  /* ----- Panels ----- */
  .panel {
    margin-top: clamp(14px, 1.6vw, 20px);
    animation: tab-fade 0.22s ease both;
  }
  .panel[hidden] { display: none; }
  .panel:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  @keyframes tab-fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ----- Projects / Lab: cards ----- */
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.4vw, 18px);
  }

  .card {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: clamp(14px, 1.8vw, 26px);
    padding: clamp(9px, 1.1vw, 12px);
    background: var(--mw-shell, #2e2e2e);
    border: 1px solid var(--tab-active-border, rgba(255, 255, 255, 0.14));
    border-radius: 0;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .card-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(4px, 0.6vw, 8px) clamp(6px, 0.8vw, 12px) clamp(6px, 0.8vw, 10px) 0;
  }

  .card-out {
    flex: none;
    display: inline-flex;
    color: var(--text-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .card-out:hover {
    color: var(--text-strong);
    transform: translate(1px, -1px);
  }
  .card-out:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  /* Collapsed to 3 lines. max-height is what actually animates — the clamp
     only supplies the ellipsis, and line-clamp itself can't transition. */
  .card-blurb {
    margin: clamp(10px, 1.2vw, 14px) 0 0;
    /* The card spans the full width, so at 1920px the text column is ~1450px.
       Three lines at that measure is ~200 characters each. Cap the line length
       without narrowing the card. */
    max-width: 68ch;
    font-size: clamp(0.88rem, 1.02vw, 0.98rem);
    line-height: 1.5;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 4.5em; /* 3 lines x 1.5 */
    transition: max-height 0.3s ease;
  }

  .card-foot {
    margin-top: auto;
    padding-top: clamp(12px, 1.5vw, 18px);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 12px;
  }

  /* Wraps rather than truncating — these labels are short but the footer gets
     tight once the toggle sits beside them. */

  /* ----- Webrings: prev / name / next rows ----- */
  .rings {
    margin: 0;
    padding: 0;
    list-style: none;
    /* Full width, matching the music card above. */
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ring-nav {
    display: grid;
    /* Fixed arrow cells, flexible middle. minmax(0, 1fr) so a long ring name
       can't push the row past the container. */
    grid-template-columns: 56px minmax(0, 1fr) 56px;
    align-items: stretch;
    background: var(--mw-shell, #2e2e2e);
    border: 1px solid var(--tab-active-border, rgba(255, 255, 255, 0.14));
    border-radius: 0;
    transition: border-color 0.2s ease;
  }
  .ring-nav:hover,
  .ring-nav:focus-within {
    border-color: var(--tab-border-hover, rgba(255, 255, 255, 0.32));
  }

  /* Whole cell is the target, not just the glyph. */
  .ring-arrow {
    display: grid;
    place-items: center;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .ring-arrow:first-child {
    border-right: 1px dashed var(--tab-border, rgba(255, 255, 255, 0.18));
  }
  .ring-arrow:last-child {
    border-left: 1px dashed var(--tab-border, rgba(255, 255, 255, 0.18));
  }
  /* Only the hovered arrow lights up, so direction stays legible. */
  .ring-arrow:hover {
    color: var(--ring-accent, #db5b46);
    background: rgba(255, 255, 255, 0.04);
  }
  .ring-arrow:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -3px;
  }

  .ring-body {
    min-width: 0;
    padding: 18px 16px;
    text-align: center;
  }

  .ring-name {
    margin: 0;
    font-size: clamp(0.92rem, 1.05vw, 1rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }
  .ring-name a {
    color: inherit;
    text-decoration: none;
  }
  .ring-name a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ring-name a:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .ring-note {
    margin: 3px 0 0;
    font-size: clamp(0.78rem, 0.9vw, 0.8125rem);
    line-height: 1.4;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }


  /* ----- Guestbook: add tile ----- */
  /* Two classes deep on purpose: .guest is declared further down the sheet, so
     a single .guest-add selector would lose the border and ::before contest. */
  .guest.guest-add {
    /* Dashed and empty until clicked, so it reads as a slot rather than a card. */
    justify-content: center;
    padding: 16px;
    background: transparent;
    border-style: dashed;
  }
  .guest.guest-add:hover {
    border-color: var(--tab-border-hover, rgba(255, 255, 255, 0.32));
  }
  .guest.guest-add::before { content: none; }

  .add-plus {
    appearance: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex: 1;
    width: 100%;
    padding: 0;
    cursor: pointer;
    background: none;
    border: none;
    border-radius: 0;
    color: var(--text-muted);
    font-family: inherit;
    transition: color 0.2s ease;
  }
  .add-plus:hover { color: var(--text-strong); }
  .add-plus:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
  .guest-add.is-signing .add-plus { display: none; }

  .add-label {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ----- Guestbook: sign form (lives inside the add tile) ----- */
  .sign {
    display: none;
    flex: 1;
    flex-direction: column;
    gap: 8px;
  }
  .guest-add.is-signing .sign { display: flex; }

  .sign-input {
    appearance: none;
    width: 100%;
    min-width: 0;
    padding: 9px 10px;
    border: 1px dashed var(--tab-border, rgba(255, 255, 255, 0.18));
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 0.9375rem;
    line-height: 1.3;
    transition: border-color 0.2s ease;
  }
  .sign-msg {
    flex: 1;
    min-height: 62px;
    resize: none;
    font-family: inherit;
  }
  .sign-input::placeholder { color: var(--text-muted); }
  .sign-input:hover { border-color: var(--tab-border-hover, rgba(255, 255, 255, 0.32)); }
  .sign-input:focus {
    outline: none;
    border-style: solid;
    border-color: var(--text);
  }

  /* Off-screen rather than display:none, so bots still see a fillable field. */
  .sign-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .sign-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sign-cancel {
    appearance: none;
    padding: 9px 4px;
    cursor: pointer;
    background: none;
    border: none;
    border-radius: 0;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }
  .sign-cancel:hover { color: var(--text-strong); }
  .sign-cancel:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .sign-btn {
    appearance: none;
    flex: 1;
    padding: 9px 18px;
    cursor: pointer;
    border: 1px solid var(--tab-active-border, rgba(255, 255, 255, 0.14));
    border-radius: 0;
    background: var(--tab-active-bg, #2e2e2e);
    color: var(--tab-active-text, #fefefe);
    font-family: inherit;
    font-size: 0.9375rem;
    line-height: 1.3;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }
  .sign-btn:hover { border-color: var(--tab-border-hover, rgba(255, 255, 255, 0.32)); }
  .sign-btn:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
  .sign-btn:disabled { opacity: 0.55; cursor: default; }

  .sign-note {
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.4;
    text-align: center;
    color: var(--text-muted);
  }

  /* ----- Guestbook: passport-stamp cards -----
     Date at the top, message in the middle, name + country pinned to the
     bottom. Corner brackets and postmark are pure CSS, no images. */
  .guests {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    /* Fixed 4 per row across the full width of the music card, so stamp 5
       starts a fresh row rather than the count drifting with the viewport.
       minmax(0, 1fr) — a bare 1fr has min-width auto and a long country name
       would push the row past the container. */
    grid-template-columns: repeat(var(--guest-cols, 4), minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 22px);
    max-width: none;
  }

  .guest {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    /* Portrait, like a real stamp. height stays auto so a long message can
       push past the ratio rather than overflowing it. */
    aspect-ratio: 4 / 5;
    min-height: 320px;
    padding: 28px 22px 22px;
    text-align: center;
    background: var(--mw-shell, #2e2e2e);
    border: 1px solid var(--tab-active-border, rgba(255, 255, 255, 0.14));
    border-radius: 0;
    transition: border-color 0.2s ease;
  }
  .guest:hover {
    border-color: var(--tab-border-hover, rgba(255, 255, 255, 0.32));
  }

  /* Inner dashed frame, the way a stamp is perforated inside its edge. */

  .corner {
    position: absolute;
    width: 11px;
