---
// Soft blur along the top and bottom edge of the window: text and images
// go gradually out of focus as they scroll away, instead of being cut off.
// Reference: raphaelsalaja.com ("Progressive Blur"). Pure CSS layers; the
// small script fades the top edge in as soon as the page starts to scroll
// (so nothing is blurred at rest) and eases the bottom edge away at the very
// end of the page so the crowd stays sharp.
const LAYERS = [
  { blur: 0.5, from: 0, mid1: 12.5, mid2: 25, to: 37.5 },
  { blur: 1, from: 12.5, mid1: 25, mid2: 37.5, to: 50 },
  { blur: 2, from: 25, mid1: 37.5, mid2: 50, to: 62.5 },
  { blur: 4, from: 37.5, mid1: 50, mid2: 62.5, to: 75 },
  { blur: 8, from: 50, mid1: 62.5, mid2: 75, to: 87.5 },
  { blur: 16, from: 75, mid1: 87.5, mid2: 100, to: 100 },
];
---

<div class="sblur sblur-top" aria-hidden="true" data-sblur-top>
  {LAYERS.map((l) => (
    <i style={`--b:${l.blur}px;--m:linear-gradient(to bottom, rgba(0,0,0,0) ${100 - l.to}%, #000 ${100 - l.mid2}%, #000 ${100 - l.mid1}%, rgba(0,0,0,0) ${100 - l.from}%)`}></i>
  ))}
</div>
<div class="sblur sblur-bottom" aria-hidden="true" data-sblur-bottom>
  {LAYERS.map((l) => (
    <i style={`--b:${l.blur}px;--m:linear-gradient(to top, rgba(0,0,0,0) ${100 - l.to}%, #000 ${100 - l.mid2}%, #000 ${100 - l.mid1}%, rgba(0,0,0,0) ${100 - l.from}%)`}></i>
  ))}
</div>

<script is:inline>
  (function () {
    var b = document.querySelector('[data-sblur-bottom]');
    var t = document.querySelector('[data-sblur-top]');
    if (!b) return;
    function update() {
      if (t) t.style.opacity = Math.max(0, Math.min(1, window.scrollY / 60)).toFixed(2);
      var left = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
      var o = Math.max(0, Math.min(1, left / 160));
      b.style.opacity = o.toFixed(2);
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

<style is:global>
  .sblur {
    position: fixed;
    left: 0;
    right: 0;
    height: 88px;
    z-index: 5;
    pointer-events: none;
  }
  .sblur-top { top: 0; opacity: 0; transition: opacity 0.2s linear; }
  .sblur-bottom { bottom: 0; transition: opacity 0.2s linear; }
  .sblur i {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--b));
    backdrop-filter: blur(var(--b));
    -webkit-mask-image: var(--m);
    mask-image: var(--m);
  }
  @media (prefers-reduced-motion: reduce) {
    .sblur-bottom { transition: none; }
  }
  @media (max-width: 480px) { .sblur { height: 64px; } }
</style>
