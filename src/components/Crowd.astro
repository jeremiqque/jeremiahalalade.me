---
// A little crowd that strolls along the bottom of the page.
// Reference: the walking crowd in aarivi.com's footer. The people here are
// drawn in code, so there is no image to load.
---

<div class="crowd" aria-hidden="true">
  <canvas data-crowd></canvas>
</div>

<script is:inline>
  // A crowd of people walking along the bottom of the page, the same idea as
  // aarivi.com's footer: one sprite sheet of 105 characters (15 x 7), each one
  // crossing the strip at its own speed, hopping as it walks.
  (function () {
    var cv = document.querySelector('[data-crowd]');
    if (!cv) return;
    var ctx = cv.getContext('2d');
    if (!ctx) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var COLS = 15, ROWS = 7, CROSS = 14;      // seconds for one crossing at speed 1
    var img = new Image();
    var peeps = [];
    var W = 0, H = 0, dpr = 1, scale = 1, cellW = 0, cellH = 0;

    function rnd(a, b) { return a + Math.random() * (b - a); }
    // Starts slow and speeds up, so most people walk near the front.
    function easeIn2(v) { return v * v; }
    function smooth(v) { return v * v * (3 - 2 * v); }

    function setup() {
      cellW = img.naturalWidth / COLS;
      cellH = img.naturalHeight / ROWS;
      peeps = [];
      for (var i = 0; i < COLS * ROWS; i++) {
        peeps.push({ sx: (i % COLS) * cellW, sy: ((i / COLS) | 0) * cellH, p: 0, dir: 1, speed: 1, y: 0, w: 0, h: 0, hopAt: 0 });
      }
      peeps.forEach(function (p) { respawn(p, Math.random()); });
    }

    function layout(p) {
      p.w = cellW * scale; p.h = cellH * scale;
      var o = p.h / 324;
      var q = (100 - 250 * easeIn2(Math.random())) * o;
      var top = Math.max(12, H * 0.2);
      var low = H - p.h;
      p.y = Math.max(top, Math.min(low, low + q));
    }

    function respawn(p, progress) {
      p.dir = Math.random() < 0.5 ? 1 : -1;
      p.speed = rnd(0.38, 0.95);
      p.p = progress || 0;
      p.hopPhase = Math.random();
      layout(p);
    }

    function resize() {
      var r = cv.getBoundingClientRect();
      W = r.width; H = r.height;
      if (!W || !H) return;
      dpr = Math.max(1, window.devicePixelRatio || 1);
      scale = Math.max(0.28, Math.min(1, W / 1440, H * 0.72 / 324));
      cv.width = Math.round(W * dpr);
      cv.height = Math.round(H * dpr);
      if (peeps.length) peeps.forEach(function (p) { layout(p); });
    }

    function draw() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, cv.width, cv.height);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      var list = peeps.slice().sort(function (a, b) { return (a.y + a.h) - (b.y + b.h); });
      var amp = Math.max(3, 10 * (list.length ? list[0].h / 324 : 1));
      for (var i = 0; i < list.length; i++) {
        var p = list[i];
        var x = p.dir === 1 ? -p.w + p.p * (W + p.w) : W - p.p * (W + p.w);
        if (x > W + 4 || x < -p.w - 4) continue;
        var hop = Math.min(1, Math.max(0, p.hop));
        var y = p.y - amp * (p.h / 324 / (list[0].h / 324)) * hop;
        ctx.save();
        ctx.translate(p.dir === 1 ? x : x + p.w, y);
        ctx.scale(p.dir, 1);
        ctx.drawImage(img, p.sx, p.sy, cellW, cellH, 0, 0, p.w, p.h);
        ctx.restore();
      }
    }

    var last = 0, t = 0, raf = 0;
    function frame(ts) {
      raf = requestAnimationFrame(frame);
      var dt = last ? Math.min((ts - last) / 1000, 0.05) : 0.016;
      last = ts; t += dt;
      for (var i = 0; i < peeps.length; i++) {
        var p = peeps[i];
        p.p += dt * p.speed / CROSS;
        if (p.p >= 1) respawn(p, 0);
        // A hop every 0.32s of the person's own time: up, then back down.
        var u = (t * p.speed / 0.32 + p.hopPhase * 2) % 2;
        p.hop = smooth(u < 1 ? u : 2 - u);
      }
      draw();
    }

    function start() {
      setup();
      resize();
      if (reduced) { peeps.forEach(function (p) { p.hop = 0; }); draw(); return; }
      var visible = true;
      function sync() {
        var run = visible && !document.hidden;
        if (run && !raf) { last = 0; raf = requestAnimationFrame(frame); }
        else if (!run && raf) { cancelAnimationFrame(raf); raf = 0; }
      }
      document.addEventListener('visibilitychange', sync);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (en) { visible = en[0].isIntersecting; sync(); }).observe(cv);
      }
      sync();
    }

    window.addEventListener('resize', function () { resize(); if (reduced) draw(); });
    img.onload = start;
    img.src = '/assets/peeps/all-peeps.png';
    if (img.complete && img.naturalWidth) start();
  })();
</script>

<style is:global>
  .crowd {
    position: relative;
    width: 100%;
    height: 180px;
    margin-top: 8px;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }
  .crowd canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  @media (max-width: 480px) { .crowd { height: 140px; } }
</style>
