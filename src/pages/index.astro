---
// Jeremiah Alalade — personal landing page
// Built from the Figma "Lumis / My iste" frame (1518×551). Responsive, desktop-first.
import Crowd from '../components/Crowd.astro';
import ScrollBlur from '../components/ScrollBlur.astro';
import MusicWidget from '../components/MusicWidget.astro';
import Tabs from '../components/Tabs.astro';
import SoundToggle from '../components/SoundToggle.astro';
const email = 'hey@jeremiahalalade.me';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href="/fonts/PPNeueCorp-CompactMedium.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Jeremiah Alalade — Product designer engineer." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23181818'/><rect x='3' y='3' width='26' height='26' rx='3' fill='%23202020'/></svg>" />
    <title>Jeremiah Alalade</title>
    <meta name="theme-color" content="#f2f2f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181818" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jeremiah Alalade" />
    <meta property="og:description" content="Jeremiah Alalade — Product designer engineer." />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Set theme before paint to avoid a flash of the wrong colors.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <main class="card">
      <header class="top">
        <div class="intro">
          <button class="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <line x1="12" y1="3" x2="12" y2="21" />
              <line x1="12" y1="9" x2="16.65" y2="4.35" />
              <line x1="12" y1="14.3" x2="19.37" y2="6.93" />
              <line x1="12" y1="19.6" x2="20.85" y2="10.75" />
            </svg>
          </button>
          <SoundToggle />

          <div class="name-row">
            <h1 class="name">Jeremiah Alalade</h1>

          </div>
          <p class="role">Design Engineer</p>
          <div class="bio">
            <p>I'm a design engineer based in Nigeria.</p>
            <p>I currently work with <span class="peek"><img class="ico" src="/assets/logos/campusupdate.png" alt="" width="16" height="16" /><a class="bio-link" href="https://campusupdate.divacatech.com/" target="_blank" rel="noopener noreferrer">CampusUpdate</a><span class="peek-card" aria-hidden="true"><span class="peek-bar"><i></i><i></i><i></i><b></b></span><img data-src="/assets/previews/campusupdate.jpg" alt="" width="256" height="160" decoding="async" /></span></span> as a co-founding design engineer, where I spend most of my time on the details most people never notice but always feel. I highlight curiosity as a personal quality.</p>
            <p>Before CampusUpdate, I worked with <span class="peek"><img class="ico" src="/assets/logos/axiomblack.png" alt="" width="16" height="16" /><a class="bio-link" href="https://axiomblack.com/" target="_blank" rel="noopener noreferrer">axiomblack.com</a><span class="peek-card" aria-hidden="true"><span class="peek-bar"><i></i><i></i><i></i><b></b></span><img data-src="/assets/previews/axiomblack.jpg" alt="" width="256" height="160" decoding="async" /></span></span>, <span class="peek"><img class="ico" src="/assets/logos/hydratech.png" alt="" width="16" height="16" /><a class="bio-link" href="https://hydratechinnovations.ng/" target="_blank" rel="noopener noreferrer">hydratechinnovations.ng</a><span class="peek-card" aria-hidden="true"><span class="peek-bar"><i></i><i></i><i></i><b></b></span><img data-src="/assets/previews/hydratech.jpg" alt="" width="256" height="160" decoding="async" /></span></span> and <span class="peek"><img class="ico" src="/assets/logos/springcitadel.png" alt="" width="16" height="16" /><a class="bio-link" href="https://www.springcitadelschool.com/" target="_blank" rel="noopener noreferrer">springcitadelintschool.com</a><span class="peek-card" aria-hidden="true"><span class="peek-bar"><i></i><i></i><i></i><b></b></span><img data-src="/assets/previews/springcitadel.jpg" alt="" width="256" height="160" decoding="async" /></span></span>.</p>
            <p>Along the way, I freelanced on <a class="bio-link" href="https://www.upwork.com/freelancers/~015e96558bbb1bacc9" target="_blank" rel="noopener noreferrer">Upwork</a> and Fiverr.</p>
            <p>You can find me on <span class="ref"><span class="ico " style="background:#111111" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg></span><a class="bio-link" href="https://x.com/jeremiqque" target="_blank" rel="noopener noreferrer">X (Twitter)</a></span>, <span class="ref"><span class="ico " style="background:#2b3137" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></span><a class="bio-link" href="https://github.com/jeremiqque" target="_blank" rel="noopener noreferrer">GitHub</a></span>, <span class="ref"><span class="ico " style="background:#0a66c2" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></span><a class="bio-link" href="https://www.linkedin.com/in/jeremiqque/" target="_blank" rel="noopener noreferrer">LinkedIn</a></span>, <span class="ref"><span class="ico " style="background:linear-gradient(45deg,#f9a03f,#e1306c 55%,#833ab4)" aria-hidden="true"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg></span><a class="bio-link" href="https://instagram.com/jere_miqque" target="_blank" rel="noopener noreferrer">Instagram</a></span>, <span class="ref"><span class="ico " style="background:#14a800" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.548-1.405-.002-2.543-1.143-2.545-2.548V3.492H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-1.19c.529 1.107 1.182 2.229 1.974 3.221l-1.673 7.873h2.797l1.213-5.71c1.063.679 2.285 1.109 3.686 1.109 3 0 5.439-2.452 5.439-5.45 0-3-2.439-5.449-5.439-5.449z"/></svg></span><a class="bio-link" href="https://www.upwork.com/freelancers/~015e96558bbb1bacc9" target="_blank" rel="noopener noreferrer">Upwork</a></span> and <span class="ref"><span class="ico " style="background:#4a4a52" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><path d="M11.54 2.14a.75.75 0 0 1 .92 0l8.75 6.8a.75.75 0 0 1 0 1.19l-8.75 6.8a.75.75 0 0 1-.92 0l-8.75-6.8a.75.75 0 0 1 0-1.19l8.75-6.8Zm-8.13 10.9a.75.75 0 0 1 1.05-.13L12 18.8l7.54-5.89a.75.75 0 1 1 .92 1.18l-8 6.25a.75.75 0 0 1-.92 0l-8-6.25a.75.75 0 0 1-.13-1.05Z"/></svg></span><a class="bio-link" href="https://layers.to/jeremiqque" target="_blank" rel="noopener noreferrer">Layers</a></span>, or reach me by <a class="bio-link" href={`mailto:${email}`}>email</a>.</p>
          </div>
        </div>

        <p class="last-visitor" data-last-visitor hidden>
          <span class="lv-label">Last visitor:</span>
          <span class="lv-place" data-lv-place></span>
        </p>
      </header>

      <hr class="divider" />

      <div class="music-slot">
        <MusicWidget />
      </div>

      <Tabs />


      <p class="footer">© {year} Jeremiah Alalade</p>
    </main>

    <Crowd />
    <ScrollBlur />

  </body>
</html>

<script is:inline>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>

<script is:inline>
  // Fetch the previous visitor's location and reveal the line.
  (function () {
    var el = document.querySelector('[data-last-visitor]');
    var place = document.querySelector('[data-lv-place]');
    if (!el || !place) return;
    fetch('/api/visitor')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        var v = data && data.visitor;
        if (v && v.city && v.country) {
          place.textContent = v.city + ', ' + v.country;
          el.hidden = false;
        }
      })
      .catch(function () {});
  })();
</script>

<script is:inline>
  // Place each hover preview above the link under the pointer (or the first
  // line of it when focused by keyboard). Needed because a link that wraps onto
  // two lines has no single box to centre on.
  (function () {
    var peeks = document.querySelectorAll('.peek');
    function place(peek, e) {
      var link = peek.querySelector('a');
      var card = peek.querySelector('.peek-card');
      if (!link || !card) return;
      var rects = link.getClientRects();
      var r = rects[0];
      if (e && typeof e.clientX === 'number') {
        for (var i = 0; i < rects.length; i++) {
          if (e.clientX >= rects[i].left && e.clientX <= rects[i].right &&
              e.clientY >= rects[i].top && e.clientY <= rects[i].bottom) { r = rects[i]; break; }
        }
      }
      var w = 256, h = card.offsetHeight || 180, gap = 10;
      var left = Math.min(Math.max(r.left + r.width / 2 - w / 2, 8), window.innerWidth - w - 8);
      var top = r.top - h - gap;
      if (top < 8) top = r.bottom + gap;
      card.style.left = left + 'px';
      card.style.top = top + 'px';
    }
    // Hover previews download shortly after the page has loaded (or the moment
    // someone points at a link), never as part of the first paint.
    function loadPeek(img) { if (img && img.dataset.src) { img.src = img.dataset.src; delete img.dataset.src; } }
    peeks.forEach(function (peek) {
      var img = peek.querySelector('img[data-src]');
      peek.addEventListener('pointerenter', function () { loadPeek(img); }, { once: true });
      peek.addEventListener('focusin', function () { loadPeek(img); }, { once: true });
    });
    window.addEventListener('load', function () {
      setTimeout(function () {
        Array.prototype.forEach.call(document.querySelectorAll('.peek-card img[data-src]'), loadPeek);
      }, 1500);
    });

    peeks.forEach(function (peek) {
      peek.addEventListener('mouseenter', function (e) { place(peek, e); });
      peek.addEventListener('mousemove', function (e) { place(peek, e); });
      peek.addEventListener('focusin', function () { place(peek, null); });
    });
  })();
</script>

<style>
  /* ----- Fonts (local OTF, exposed as CSS variables) ----- */
  @font-face {
    font-family: 'Nimbu Demo';
    src: url('/fonts/NimbuDemo-Medium.woff2') format('woff2'), url('/fonts/NimbuDemo-Medium.otf') format('opentype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'PP Neue Corp Compact';
    src: url('/fonts/PPNeueCorp-CompactMedium.woff2') format('woff2'), url('/fonts/PPNeueCorp-CompactMedium.otf') format('opentype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-heading: 'Nimbu Demo', sans-serif;
    --font-body: 'PP Neue Corp Compact', sans-serif;
  }

  /* ----- Theme palettes ----- */
  :root,
  :root[data-theme='dark'] {
    --bg-card: #202020;
    --text: #f2f2f2;
    --text-strong: #fefefe;
    --divider: #3d3d3d;
    --link-underline: rgba(242, 242, 242, 0.45);
    --link-underline-hover: #f2f2f2;

    --mw-shell: #2e2e2e;
    --mw-panel: #202020;
    --mw-title: #f2f2f2;
    --mw-artist: #c9c9c9;
    --mw-footer: #f2f2f2;

    --toggle-bg: rgba(255, 255, 255, 0.06);
    --toggle-border: rgba(255, 255, 255, 0.16);
    --toggle-bg-hover: rgba(255, 255, 255, 0.12);

    --text-muted: rgba(242, 242, 242, 0.55);
    --bg-page: #080808;

    /* Same hue as the link accent, one step higher so it keeps the visual
       weight the blue had (8.44:1 on the card). */
    --lv-accent: #f3a89a;

    --tab-border: rgba(255, 255, 255, 0.18);
    --tab-border-hover: rgba(255, 255, 255, 0.32);
    --tab-text: rgba(242, 242, 242, 0.6);
    --tab-text-hover: #f2f2f2;
    --tab-active-bg: #2e2e2e;
    --tab-active-border: rgba(255, 255, 255, 0.14);
    --tab-active-text: #fefefe;
    --tab-more: rgba(242, 242, 242, 0.6);

    /* Selected tab: solid accent fill. Separate tokens from --tab-active-*,
       which the cards, stamps and ring rows use for their borders. */
    --tab-on-bg: #cb4834;
    --tab-on-text: #ffffff;

    /* Graphic marks on a dark surface — equalizer bars, the spinning vinyl.
       Lighter than --tab-on-bg on purpose: that one has to hold white text at
       4.5:1, this one has to clear 3:1 against #2e2e2e and #202020. One value
       can't do both, so they're two steps of the same hue. */
    --accent-mark: #db5b46;
    --tab-frame: #2e2e2e;
    --ring-accent: var(--accent-mark); /* hovered webring arrow */

    /* Inline link accent, on the hue of #330a05 = oklch(0.218 0.067 31.2).
       The hex itself reads 1.09:1 on the card, so it can't carry text; this is
       the same hue lifted to oklch(0.65 0.105 31.2) for 4.82:1, which clears
       AA for body copy. */
    --link-accent: #c77667;
  }

  :root[data-theme='light'] {
    --bg-card: #f3f3f3;
    --text: #1f1f1f;
    --text-strong: #0d0d0d;
    --divider: #c2c2c2;
    --link-underline: rgba(31, 31, 31, 0.4);
    --link-underline-hover: #1f1f1f;

    --mw-shell: #e5e5e5;
    --mw-panel: #f3f3f3;
    --mw-title: #1f1f1f;
    --mw-artist: #5a5a5a;
    --mw-footer: #1f1f1f;

    --toggle-bg: rgba(0, 0, 0, 0.05);
    --toggle-border: rgba(0, 0, 0, 0.14);
    --toggle-bg-hover: rgba(0, 0, 0, 0.1);

    /* Raised from 0.55 so muted text clears 4.5:1 on the page and on cards. */
    --text-muted: rgba(31, 31, 31, 0.7);
    --bg-page: #f3f3f3;

    --lv-accent: #925b51;

    --tab-border: rgba(0, 0, 0, 0.2);
    --tab-border-hover: rgba(0, 0, 0, 0.38);
    --tab-text: rgba(31, 31, 31, 0.72);
    --tab-text-hover: #1f1f1f;
    --tab-active-bg: #e5e5e5;
    --tab-active-border: rgba(0, 0, 0, 0.12);
    --tab-active-text: #0d0d0d;
    --tab-more: rgba(28, 28, 28, 0.7);

    --tab-on-bg: #cb4834;
    --tab-on-text: #ffffff;

    /* Marks go darker here so they read against the pale card. */
    --accent-mark: #a8402c;

    --tab-frame: #d9d9d9;
    --ring-accent: var(--accent-mark);

    /* Same hue, dropped down the ramp instead of up so it reads on paper:
       oklch(0.53 0.075 31.2) is 4.93:1 on #f3f3f3. */
    --link-accent: #925b51;
  }

  /* ----- Reset + page ----- */
  *,
  *::before,
  *::after { box-sizing: border-box; }

  html, body { height: 100%; }

  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* One narrow column in the middle of the page, text left-aligned inside it
     (reference: raphaelsalaja.com). 688px = a 640px column + 24px gutters. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 48px;
    width: 100%;
    max-width: 688px;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0 auto;
    padding: 64px 24px 16px;
    text-align: left;
  }

  /* ----- Header: small name, muted role underneath ----- */
  .top {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .intro { min-width: 0; }

  .name-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 10px 14px;
  }
  .name {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-strong);
  }
  .role {
    margin: 6px 0 0;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--text-muted);
  }

  /* ----- Bio ----- */
  .bio {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin: 28px 0 0;
  }
  .bio p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
  }

  .bio .bio-link {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--link-underline);
    transition: text-decoration-color 0.2s ease;
  }
  .bio .bio-link:hover { text-decoration-color: var(--link-underline-hover); }
  .bio .bio-link:focus-visible {
    outline: 2px solid var(--link-accent);
    outline-offset: 2px;
  }

  .ref, .peek { white-space: nowrap; }

  /* Small icon tile in front of each link. */
  .ico {
    position: relative;
    top: -1px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-right: 5px;
    /* "middle" centres the tile on the text's x-height, so icon and words
       share one visual line. */
    vertical-align: middle;
    border-radius: 4px;
    object-fit: cover;
    color: #fff;
    overflow: hidden;
  }
  .ico svg { width: 10px; height: 10px; }
  /* The Axiom Black mark is dark on transparent, so give it a light tile. */
  .ico[src*='axiomblack'] { background: #fff; padding: 1px; box-sizing: border-box; }

  /* ----- Hover preview on company links (reference: raphaelsalaja.com) ----- */
  .peek { position: relative; display: inline; }
  .peek-card {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    display: block;
    width: 256px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--bg-card);
    box-shadow: 0 0 0 1px rgba(128, 128, 128, 0.28), 0 1px 2px rgba(0, 0, 0, 0.12),
      0 12px 32px rgba(0, 0, 0, 0.28);
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px) scale(0.96);
    transform-origin: 50% 100%;
